# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL via PG8000. Percent-encode special characters in the password
# (e.g. "@" -> "%40").
DATABASE_URL=postgresql+pg8000://postgres:change-me@localhost:5432/postgres_db

# Separate database used ONLY by the test suite. The name must end with "_test";
# the tests refuse to run otherwise.
TEST_DATABASE_URL=postgresql+pg8000://postgres:change-me@localhost:5432/postgres_test

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars

ACCESS_TOKEN_EXPIRE_MINUTES=60
